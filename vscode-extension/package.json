{
  "name": "cairn",
  "displayName": "Cairn",
  "description": "Build-gated version control for Rust - automatically snapshot on successful builds",
  "version": "0.0.1",
  "publisher": "fractaldecoder",
  "icon": "resources/cairn-icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/yourusername/cairn"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "cairn.refresh",
        "title": "Cairn: Refresh",
        "category": "Cairn"
      },
      {
        "command": "cairn.run",
        "title": "Cairn: Run",
        "category": "Cairn"
      },
      {
        "command": "cairn.runRelease",
        "title": "Cairn: Run (Release)",
        "category": "Cairn"
      },
      {
        "command": "cairn.build",
        "title": "Cairn: Build",
        "category": "Cairn"
      },
      {
        "command": "cairn.buildRelease",
        "title": "Cairn: Build (Release)",
        "category": "Cairn"
      },
      {
        "command": "cairn.check",
        "title": "Cairn: Check",
        "category": "Cairn"
      },
      {
        "command": "cairn.test",
        "title": "Cairn: Test",
        "category": "Cairn"
      },
      {
        "command": "cairn.clean",
        "title": "Cairn: Clean",
        "category": "Cairn"
      },
      {
        "command": "cairn.showPatch",
        "title": "Cairn: Show Patch",
        "category": "Cairn"
      }
    ],
    "views": {
      "explorer": [
        {
          "id": "cairnView",
          "name": "Cairn"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/node": "^20.x",
    "@types/vscode": "^1.85.0",
    "@typescript-eslint/eslint-plugin": "^6.x",
    "@typescript-eslint/parser": "^6.x",
    "eslint": "^8.x",
    "typescript": "^5.3.0"
  }
}
