{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Build Cairn Binaries",
            "type": "shell",
            "command": "cargo",
            "args": ["build", "--bins"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$rustc"],
            "group": "build",
            "presentation": {
                "reveal": "always",
                "panel": "shared"
            }
        },
        {
            "type": "npm",
            "script": "watch",
            "path": "vscode-extension",
            "problemMatcher": "$tsc-watch",
            "isBackground": true,
            "presentation": {
                "reveal": "never"
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "dependsOn": ["Build Cairn Binaries"]
        },
        {
            "type": "npm",
            "script": "compile",
            "path": "vscode-extension",
            "group": "build",
            "problemMatcher": "$tsc",
            "dependsOn": ["Build Cairn Binaries"]
        }
    ]
}
